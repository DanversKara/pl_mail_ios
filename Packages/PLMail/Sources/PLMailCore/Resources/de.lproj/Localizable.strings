/* Die Rollennamen der Postfächer — die meistgelesenen Wörter der App.
   Bewusst an Apple Mail angelehnt, damit Vokabular nicht zwischen zwei
   Mail-Apps auf demselben Gerät auseinanderläuft. */

"Inbox" = "Posteingang";
"Sent" = "Gesendet";
"Drafts" = "Entwürfe";
"Spam" = "Werbung";
"Trash" = "Papierkorb";
"Archive" = "Archiv";
"Snoozed" = "Zurückgestellt";
"Starred" = "Markiert";
"Important" = "Wichtig";
"All mail" = "Alle E-Mails";

/* Die voreingestellten Zeiten, gemeinsam genutzt von „Zurückstellen“ und
   „Später senden“. */

"Later today" = "Später heute";
"Tomorrow" = "Morgen";
"Tomorrow evening" = "Morgen Abend";
"This weekend" = "Am Wochenende";
"Next week" = "Nächste Woche";
